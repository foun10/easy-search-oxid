{
  "name": "foun10/easysearch",
  "description": "Product search for OXID eShop with typo tolerance, facets and suggest",
  "type": "oxideshop-module",
  "keywords": [
    "oxid",
    "modules",
    "eShop",
    "search",
    "facets",
    "suggest",
    "meilisearch"
  ],
  "homepage": "https://www.foun10.de",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "foun10 GmbH",
      "email": "info@foun10.de"
    }
  ],
  "extra": {
    "oxideshop": {
      "target-directory": "foun10/EasySearch",
      "blacklist-filter": [
        "tests/**/*",
        "vendor/**/*",
        "phpunit.xml",
        "composer.lock",
        ".github/**/*"
      ]
    }
  },
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "symfony/console": "^5.4 || ^6.0"
  },
  "autoload": {
    "psr-4": {
      "foun10\\EasySearch\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "foun10\\EasySearch\\Tests\\": "./tests"
    }
  },
  "scripts": {
    "tests-unit": "phpunit --testsuite unit",
    "tests-integration": "phpunit -c phpunit.integration.xml",
    "tests-mutation": "infection --threads=4 --min-covered-msi=82 --no-interaction"
  },
  "config": {
    "sort-packages": true
  }
}
